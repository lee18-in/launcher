#!/bin/sh
# Validate that commit message follows AGENTS.md §3 format: [plan/build/maintain/takeover] action description
commit_msg_file="$1"
first_line=$(head -n 1 "$commit_msg_file")

if ! printf '%s' "$first_line" | grep -qE '^\[(plan|build|maintain|takeover)\]'; then
  echo "Error: Commit message must start with [plan] / [build] / [maintain] / [takeover] tag (see AGENTS.md §3)." >&2
  echo "Current message: $first_line" >&2
  exit 1
fi
